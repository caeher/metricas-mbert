# Copy to .env.argilla and replace every value before starting the server.
# Use URL-safe passwords because ARGILLA_DATABASE_URL embeds the DB password.
ARGILLA_API_URL=http://localhost:6900
ARGILLA_USERNAME=argilla-owner
ARGILLA_PASSWORD=replace-with-a-long-unique-url-safe-password
ARGILLA_API_KEY=replace-with-a-long-random-api-key
ARGILLA_AUTH_SECRET_KEY=replace-with-a-random-64-character-hex-secret
ARGILLA_DB_PASSWORD=replace-with-a-long-unique-url-safe-password
ARGILLA_WORKSPACE=annotations
ARGILLA_AUDIT_WORKSPACE=restricted-audit
